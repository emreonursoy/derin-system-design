   "link": null,
   "locked": false
  },
  {
   "id": "text-redis-uses",
   "type": "text",
   "x": 1966,
   "y": 915.0,
   "width": 327.36,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1144,
   "version": 1,
   "versionNonce": 1144,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Rate limits, AI requests    1 to 5 minutes\nQuery concurrency           seconds\nQuery cache                 60s\nLive rollups, data version  until next batch\nHeld segments (proposed)    until released\nSSE wake-ups (turn ID)      not stored",
   "originalText": "Rate limits, AI requests    1 to 5 minutes\nQuery concurrency           seconds\nQuery cache                 60s\nLive rollups, data version  until next batch\nHeld segments (proposed)    until released\nSSE wake-ups (turn ID)      not stored",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "box-redis-uses",
   "lineHeight": 1.25,
   "autoResize": true
  },
