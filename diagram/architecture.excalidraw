   "roundness": null,
   "seed": 1148,
   "version": 1,
   "versionNonce": 1148,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If we lose it, no participant data is lost:\nSaves continue, with weaker limits\nDashboard chat pauses; interviews continue\nPolls and queries use the replica: \"busy\"\nWake-ups check Postgres; rollups republish\nSmall segments: \"too few responses\"",
   "originalText": "If we lose it, no participant data is lost:\nSaves continue, with weaker limits\nDashboard chat pauses; interviews continue\nPolls and queries use the replica: \"busy\"\nWake-ups check Postgres; rollups republish\nSmall segments: \"too few responses\"",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "box-redis-lost",
   "lineHeight": 1.25,
   "autoResize": true
  },
